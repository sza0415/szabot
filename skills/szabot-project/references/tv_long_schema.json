          { "name": "Fcopyright_start", "label": "版权开始时间", "type": "string" },
          { "name": "Fcopyright_end", "label": "版权结束时间", "type": "string" }
        ]
      },
      "result_fields": {
        "_id": "ledger_id", "Fip_name": "name", "Fip_use_name": "ip_use_name",
        "Fcopyright_start": "authorize_start_time", "Fcopyright_end": "authorize_end_time"
      },
